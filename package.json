{
  "name": "petbio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "lint": "node tests/lint.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:api": "python -m pytest tests/api -q",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test": "npm run lint && npm run test:unit && npm run test:api && npm run test:e2e",
    "test:cov": "bash tests/run-all.sh"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "c8": "^10.1.2",
    "jsdom": "^24.0.0",
    "playwright": "^1.48.0"
  }
}
